# Postgres connection string (Neon / Supabase / Vercel Postgres ...)
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=replace_with_a_long_random_secret
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_key
# From Stripe Dashboard > Developers > Webhooks (endpoint: https://YOUR-DOMAIN/api/webhooks/stripe, event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=egp
# Public URL of the site (Stripe redirects here). On Vercel it falls back to the deployment URL if empty.
CLIENT_URL=http://localhost:5173
# Vercel Cron auth (any long random string)
CRON_SECRET=replace_with_a_long_random_secret
PORT=3000
