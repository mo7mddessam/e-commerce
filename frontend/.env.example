# Frontend server settings (no secrets here — everything in the browser is public)
PORT=5173
# Where the existing Node API is running; the frontend proxies /backend/* to it
BACKEND_URL=http://localhost:3000
# Display currency. Should match STRIPE_CURRENCY on the backend (backend default: EGP)
STORE_CURRENCY=EGP
# Optional: call the API directly instead of through the proxy (requires CORS on the backend)
# API_URL=http://localhost:3000
