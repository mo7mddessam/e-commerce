{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "frontend/public",
  "rewrites": [
    { "source": "/backend/:path*", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|backend/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/release-reservations", "schedule": "0 3 * * *" }
  ]
}
